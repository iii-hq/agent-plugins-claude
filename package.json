{
  "name": "agent-plugins-claude",
  "version": "0.3.0",
  "private": true,
  "description": "The iii Claude Code plugin marketplace: the iii plugin and the source of its command line.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:committed-build": "node scripts/build.mjs --check",
