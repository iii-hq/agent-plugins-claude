{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/index.mjs\" session-start",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/index.mjs\" sync --quiet >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__plugin_iii_iii__(iii_status|iii_get_agent|iii_observations_poll|iii_observations_sse|iii_observers|iii_unobserve)$",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"iii plugin: read-only engine tool\"}}'"
          }
        ]
      },
      {
        "matcher": "^mcp__plugin_iii_iii__iii_call$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/index.mjs\" approve-call"
          }
        ]
      }
    ]
  }
}
